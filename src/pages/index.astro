---
// index.astro — Main landing page
// Reads from src/data/site.json which is generated by the orchestrator
import siteData from '../data/site.json';

const { igHandle, description, images, colors, navItems } = siteData;
const primary = colors?.primary || '#0f172a';
const secondary = colors?.secondary || '#6366f1';
const accent = colors?.accent || '#f59e0b';
const bg = colors?.background || '#ffffff';
const textColor = colors?.text || '#1e293b';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{igHandle.replace(/_/g, ' ')} — Portfolio</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;900&display=swap" rel="stylesheet" />
    <style>
      :root {
        --primary: {primary};
        --secondary: {secondary};
        --accent: {accent};
        --bg: {bg};
        --text: {textColor};
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); }
    </style>
  </head>
  <body>

    <!-- NAV -->
    <nav class="fixed top-0 w-full z-50 flex items-center justify-between px-8 py-5 backdrop-blur-md bg-white/80 border-b border-gray-100">
      <span class="font-black text-xl tracking-tight" style={`color: var(--primary)`}>@{igHandle}</span>
      <ul class="hidden md:flex gap-8">
        {navItems.map((item: string) => (
          <li>
            <a href={`#${item.toLowerCase()}`}
               class="text-sm font-medium tracking-wide hover:opacity-70 transition-opacity"
               style={`color: var(--text)`}>{item}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- HERO -->
    <section id="home" class="relative min-h-screen flex items-center justify-center text-center overflow-hidden">
      {images?.hero && (
        <img src={`/images/${images.hero}`} alt="Hero" class="absolute inset-0 w-full h-full object-cover" />
      )}
      <div class="absolute inset-0" style={`background: linear-gradient(135deg, ${primary}cc, ${secondary}99)`}></div>
      <div class="relative z-10 px-4 max-w-4xl">
        <h1 class="text-6xl md:text-8xl font-black text-white tracking-tight leading-none mb-6">
          {igHandle.replace(/_/g, ' ')}
        </h1>
        <p class="text-xl md:text-2xl text-white/80 font-light max-w-2xl mx-auto mb-10">
          {description}
        </p>
        <a href="#gallery"
           class="inline-block px-10 py-4 rounded-full font-semibold text-sm tracking-widest uppercase transition-transform hover:scale-105"
           style={`background: var(--accent); color: var(--primary)`}>
          View Work
        </a>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="py-32 px-8 max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
      {images?.portrait && (
        <div class="relative">
          <img src={`/images/${images.portrait}`} alt="Portrait"
               class="w-full aspect-[3/4] object-cover rounded-3xl shadow-2xl" />
          <div class="absolute -bottom-6 -right-6 w-32 h-32 rounded-2xl"
               style={`background: var(--accent)`}></div>
        </div>
      )}
      <div>
        <p class="text-sm font-bold tracking-[0.3em] uppercase mb-4" style={`color: var(--secondary)`}>About</p>
        <h2 class="text-4xl md:text-5xl font-black mb-6 leading-tight" style={`color: var(--primary)`}>
          The Story Behind the Work
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-8">{description}</p>
        <a href={`https://instagram.com/${igHandle}`} target="_blank"
           class="inline-flex items-center gap-2 text-sm font-semibold tracking-wide hover:gap-4 transition-all"
           style={`color: var(--secondary)`}>
          Follow on Instagram →
        </a>
      </div>
    </section>

    <!-- GALLERY -->
    <section id="gallery" class="py-32 px-8">
      <div class="max-w-6xl mx-auto">
        <p class="text-sm font-bold tracking-[0.3em] uppercase mb-4 text-center" style={`color: var(--secondary)`}>Gallery</p>
        <h2 class="text-4xl md:text-5xl font-black text-center mb-16" style={`color: var(--primary)`}>Selected Work</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {images?.gallery?.map((img: string, i: number) => (
            <div class={`relative overflow-hidden rounded-2xl ${i === 0 ? 'col-span-2 row-span-2 aspect-square' : 'aspect-square'} group`}>
              <img src={`/images/${img}`} alt={`Gallery ${i + 1}`}
                   class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                   style={`background: ${secondary}33`}></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="py-32 px-8 text-center" style={`background: var(--primary)`}>
      <h2 class="text-4xl md:text-5xl font-black text-white mb-6">Let's Work Together</h2>
      <p class="text-white/70 text-lg max-w-xl mx-auto mb-10">{description}</p>
      <a href={`https://instagram.com/${igHandle}`} target="_blank"
         class="inline-block px-12 py-5 rounded-full font-bold tracking-widest uppercase text-sm transition-transform hover:scale-105"
         style={`background: var(--accent); color: var(--primary)`}>
        Message on Instagram
      </a>
    </section>

    <!-- FOOTER -->
    <footer class="py-8 text-center text-sm text-gray-400 border-t border-gray-100">
      © {new Date().getFullYear()} @{igHandle} · Built with Astro &amp; Cloudflare
    </footer>

  </body>
</html>
